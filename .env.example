# Copy to .env (repo root) and edit. Every variable is optional:
# with no .env at all the studio runs offline with local storage and the u2net model.

# --- Storage ----------------------------------------------------------------
# "local" (default) keeps images on disk; "s3" uses any S3-compatible bucket.
STORAGE_BACKEND=local
# Where local images live (default: <repo>/data/storage).
# Relative paths are resolved against the repository root.
LOCAL_STORAGE_DIR=./data/storage
# Copy samples/*.jpg into an empty local store on startup.
SEED_SAMPLES=true

# Only used when STORAGE_BACKEND=s3 (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces, ...)
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS; set for other providers, e.g. http://localhost:9000 for MinIO.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Models -----------------------------------------------------------------
# Background removal model:
#   u2net (default, Apache-2.0) | isnet-general-use | birefnet-general  -> rembg / ONNX Runtime
#   birefnet   -> ZhengPeng7/BiRefNet via transformers (pip install -r backend/requirements-models.txt)
#   rmbg-2.0   -> briaai/RMBG-2.0, CC BY-NC 4.0 = NON-COMMERCIAL ONLY, gated: needs HF_TOKEN
BG_REMOVAL_MODEL=u2net
# Hugging Face token, only for BG_REMOVAL_MODEL=rmbg-2.0 after accepting its licence on huggingface.co.
HF_TOKEN=
# Where the Real-ESRGAN ONNX file is written/read (default: backend/models).
# MODELS_DIR=./backend/models
# Where rembg caches its ONNX models (read by rembg itself; default ~/.rembg,
# models end up in <dir>/models/<name>/). REMBG_HOME works too.
# U2NET_HOME=~/.rembg

# --- AI clean-up: number plate / watermark removal (optional) ----------------
# Default provider when both keys are set: "openai" or "gemini".
IMAGE_EDIT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Limits -----------------------------------------------------------------
# Largest decoded input image, in pixels.
# MAX_IMAGE_PIXELS=40000000
# Largest image the Real-ESRGAN network may produce for one request (8x = two passes).
# MAX_UPSCALE_OUTPUT_PIXELS=25000000
# Model jobs that run at once, and how long a request waits for a slot before a 503.
# MAX_CONCURRENT_JOBS=1
# JOB_QUEUE_TIMEOUT_S=30

# --- HTTP -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
# Host headers the API answers to (guards against DNS rebinding); "*" disables the check.
ALLOWED_HOSTS=localhost,127.0.0.1
# Read by the Next.js dev server / build: where to proxy /api/* requests.
BACKEND_URL=http://localhost:8000
